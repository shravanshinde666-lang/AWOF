# Local development uses SQLite by default. Docker Compose builds this URL from
# the PostgreSQL values below. Replace every placeholder before deployment.
POSTGRES_DB=awof
POSTGRES_USER=awof
POSTGRES_PASSWORD=change-me-in-production
# DATABASE_URL=postgresql+psycopg://awof:change-me-in-production@localhost:5432/awof
DATABASE_ECHO=false
DEBUG=false
FRONTEND_URL=http://localhost:5173
MAX_UPLOAD_SIZE_MB=50
